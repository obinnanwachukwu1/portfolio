---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, subtitle, date } = post.data;
const words = (typeof post.body === 'string' ? post.body : '').split(/\s+/).length;
const readTime = Math.max(1, Math.round(words / 200));
---

<Base
  title={`${title} · obinna's world`}
  description={subtitle}
  type="article"
  publishedTime={date.toISOString()}
>
  <div class="cmd">cat ./writing/{post.id}.md</div>

  <article class="post" data-terminal-document>
    <h1>{title}</h1>
    <p class="meta">{date.toISOString().slice(0, 10)} · {readTime} min read</p>
    <Content />
  </article>
</Base>

<style>
  .post {
    line-height: 1.8;
  }
  .post h1 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 24px;
  }
  .post :global(h2),
  .post :global(h3) {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.6;
    margin: 40px 0 16px;
  }
  .post :global(p) {
    margin: 0 0 16px;
  }
  .post :global(a) {
    color: var(--link);
    text-decoration: none;
  }
  .post :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post .meta {
    color: var(--faint);
    font-size: 13px;
    margin: 0 0 32px;
  }
</style>
